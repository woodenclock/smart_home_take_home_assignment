# Environment Configuration for Smart Lighting System
# Copy this file to .env and modify as needed

# MQTT Configuration
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# Zigbee USB Device
# Common paths: /dev/ttyUSB0, /dev/ttyACM0, or /dev/serial/by-id/usb-...
ZIGBEE_DEVICE=/dev/ttyUSB0

# Zigbee Device Configuration
ZIGBEE_DEVICE_NAME=smart_plug
ZIGBEE_PAN_ID=0x1a62

# Timezone for Zigbee2MQTT timestamps
TZ=Asia/Singapore

# Logging
LOG_LEVEL=info
